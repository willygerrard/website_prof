# Nginx Configuration Template for Staging Environment
# Copy this to /etc/nginx/conf.d/staging.modul.sija-smkn11malang.web.id.conf
# Replace placeholder values as needed

server {
    listen 80;

    server_name staging.modul.sija-smkn11malang.web.id;

    root /var/www/html/website_prof;

    index index.php index.html;

    location /uploads/ {
        deny all;
        return 403;
    }

    client_max_body_size 50M;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; font-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;" always;

    # Sembunyikan versi Nginx
    server_tokens off;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;

        fastcgi_pass 127.0.0.1:9003;

        fastcgi_index index.php;

        fastcgi_param SCRIPT_FILENAME /var/www/html$fastcgi_script_name;
    }

    location = /login.php {
        limit_req zone=login burst=30 nodelay;
        limit_req_status 429;
        
        fastcgi_pass 127.0.0.1:9003;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/login.php;
    }

    location = /proses_login.php {
        limit_req zone=login burst=30 nodelay;
        limit_req_status 429;
       
        fastcgi_pass 127.0.0.1:9003;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/proses_login.php;
    }

    location /gerbang-rahasia-sija {
        # Rewrite diam-diam ke file asli
        rewrite ^/gerbang-rahasia-sija$ /management_modul.php last;   
    }

    location /pintu-belakang-sija {
        rewrite ^/pintu-belakang-sija$ /management_user.php last;
    }

    location /edit-soal-sija {
        rewrite ^/edit-soal-sija$ /edit_soal.php last;
    }

    location /pintu-rahasia-sija {
        rewrite ^/pintu-rahasia-sija$ /management_kuis.php last;
    }

    location /pintu-rahasia-modul {
        rewrite ^/pintu-rahasia-modul$ /management_checkpoint.php last;
    }

    location /pintu-pendaftaran-sija {
        rewrite ^/pintu-pendaftaran-sija$ /toggle_registrasi.php last;
    }

    location /pintu-game-sija {
        rewrite ^/pintu-game-sija$ /management_game.php last;
    }
}